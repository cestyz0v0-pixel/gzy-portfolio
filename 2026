<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Guizhu YUE | Portfolio</title>
<style>
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }
    body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        color: #111;
        background-color: #fff;
        display: flex;
        flex-direction: row;
        min-height: 100vh;
    }

    /* 左侧固定的艺术家信息栏 */
    .sidebar {
        width: 320px;
        padding: 60px 40px;
        position: fixed;
        top: 0;
        left: 0;
        height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        border-right: 1px solid #eee;
        background-color: #fff;
    }
    .sidebar h1 {
        font-size: 2.2rem;
        font-weight: 700;
        margin-bottom: 10px;
        letter-spacing: 0.5px;
        line-height: 1.2;
    }
    .sidebar .subtitle {
        font-size: 0.9rem;
        color: #666;
        margin-bottom: 50px;
    }
    .contact-item {
        margin-bottom: 25px;
    }
    .contact-label {
        font-size: 0.7rem;
        color: #999;
        text-transform: uppercase;
        letter-spacing: 2px;
        margin-bottom: 5px;
    }
    .contact-value {
        font-size: 0.95rem;
        color: #222;
        word-break: break-all;
    }
    .contact-value a {
        color: #222;
        text-decoration: none;
    }

    /* 右侧作品网格区域 */
    .main-content {
        margin-left: 320px;
        flex: 1;
        padding: 40px;
    }
    .portfolio-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
    }
    .portfolio-item {
        border: 1px solid #ddd;
        border-radius: 6px;
        overflow: hidden;
        background-color: #fafafa;
        transition: transform 0.2s ease;
    }
    .portfolio-item:hover {
        transform: translateY(-5px);
    }
    .portfolio-item img {
        width: 100%;
        display: block;
    }
    .portfolio-item .caption {
        padding: 10px;
        font-size: 0.9rem;
        color: #333;
    }
</style>
</head>
<body>

<div class="sidebar">
    <h1>Guizhu YUE</h1>
    <div class="subtitle">Visual Artist & Designer</div>

    <div class="contact-item">
        <div class="contact-label">Email</div>
        <div class="contact-value"><a href="mailto:example@email.com">example@email.com</a></div>
    </div>
    <div class="contact-item">
        <div class="contact-label">Website</div>
        <div class="contact-value"><a href="https://example.com" target="_blank">example.com</a></div>
    </div>
</div>

<div class="main-content">
    <div class="portfolio-grid">
        <div class="portfolio-item">
            <img src="https://via.placeholder.com/400x300" alt="Artwork 1">
            <div class="caption">Artwork Title 1</div>
        </div>
        <div class="portfolio-item">
            <img src="https://via.placeholder.com/400x300" alt="Artwork 2">
            <div class="caption">Artwork Title 2</div>
        </div>
        <div class="portfolio-item">
            <img src="https://via.placeholder.com/400x300" alt="Artwork 3">
            <div class="caption">Artwork Title 3</div>
        </div>
        <div class="portfolio-item">
            <img src="https://via.placeholder.com/400x300" alt="Artwork 4">
            <div class="caption">Artwork Title 4</div>
        </div>
    </div>
</div>

</body>
</html>
